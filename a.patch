diff --git a/test_cons_commute.hvm4 b/test_cons_commute.hvm4
new file mode 100644
index 0000000..e33507d
--- /dev/null
+++ b/test_cons_commute.hvm4
@@ -0,0 +1,24 @@
+// Test 2: Constructor Commutation
+// Scenario: We pass a Data Structure (Constructor) into a MOV node.
+// Both branches receive a fully reconstructed copy.
+
+@test_cons_commute = 
+  // 1. Create a Pair (1, 2)
+  ! data = #Pair{1, 2};
+  
+  // 2. Put it in a MOV node
+  % moved = data;
+  
+  // 3. Distribute to two branches (auto-dup)
+  (λ&m.
+    // Branch A takes m₀ and extracts the first element.
+    ! val_a = (λp. λ{ #Pair: λa. λb. a }(p))(m₀);
+    
+    // Branch B takes m₁ and extracts the second element.
+    ! val_b = (λp. λ{ #Pair: λa. λb. b }(p))(m₁);
+    
+    // 4. Result should be #Pair{1, 2}
+    #Pair{val_a, val_b}
+  )(moved)
+
+@main = @test_cons_commute
diff --git a/test_corrupted_twin.hvm4 b/test_corrupted_twin.hvm4
new file mode 100644
index 0000000..463f22f
--- /dev/null
+++ b/test_corrupted_twin.hvm4
@@ -0,0 +1,25 @@
+// Test 1: Shared Lambda Integrity
+// Branch A MOVES the lambda and uses it.
+// Branch B KEEPS the lambda and uses it.
+
+@id = λx. x
+
+@test_shared_lam =
+  // 1. Create a Lambda
+  ! f = @id;
+  
+  // 2. Share it (DUP). 'f' is auto-duplicated by the lambda below.
+  (λ&f_dup.
+    // 3. Branch A: Uses a MOV (%) node to consume f_dup₀
+    //    If the bug exists, this MOVE corrupts the underlying lambda body.
+    ! res_a = (% m = f_dup₀; m(10));
+    
+    // 4. Branch B: Uses f_dup₁ normally. 
+    //    If 'f_dup₀' corrupted the memory, 'f_dup₁' will be broken here.
+    ! res_b = f_dup₁(20);
+    
+    // 5. Result should be #Pair{10, 20}
+    #Pair{res_a, res_b}
+  )(f)
+
+@main = @test_shared_lam
diff --git a/test_erasure.hvm4 b/test_erasure.hvm4
new file mode 100644
index 0000000..197c05b
--- /dev/null
+++ b/test_erasure.hvm4
@@ -0,0 +1,22 @@
+// Test 3: Erasure Handling
+// We MOV a value, but then one of the branches gets Erased.
+
+@test_erasure =
+  // 1. Create a value
+  ! val = 42;
+  
+  // 2. Move it
+  % m = val;
+  
+  // 3. Share it and erase one branch
+  (λ&m_dup.
+    // Branch A: Consumes the value
+    ! res = m_dup₀;
+    
+    // Branch B: Erased
+    ! dummy = (λx. &{})(m_dup₁);
+    
+    res
+  )(m)
+
+@main = @test_erasure
